{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "search_frequency": {
      "type": "string",
      "enum": [
        "Weekly",
        "Every 2 weeks",
        "Monthly"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ],
      "default": "Weekly"
    },
    "frequency_rationale": {
      "type": "string",
      "description": "Written risk-based rationale for any interval longer than every 2 weeks"
    },
    "confidence_threshold": {
      "type": "number",
      "default": 85
    },
    "qc_sample_percentage": {
      "type": "number",
      "default": 10
    },
    "email_alerts": {
      "type": "boolean",
      "default": true
    },
    "reviewer_email": {
      "type": "string"
    },
    "deadline_alert_days": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "ai_model": {
      "type": "string",
      "default": "automatic"
    },
    "triage_prompt_version": {
      "type": "string",
      "default": "v1"
    }
  },
  "required": [
    "search_frequency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}