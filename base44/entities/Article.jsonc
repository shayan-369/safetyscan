{
  "name": "Article",
  "type": "object",
  "properties": {
    "search_run": {
      "type": "string",
      "description": "SearchRun id"
    },
    "source_database": {
      "type": "string",
      "enum": [
        "PubMed",
        "Embase import",
        "Canada Vigilance import",
        "Other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "gray"
      ]
    },
    "pmid": {
      "type": "string"
    },
    "pmc_id": {
      "type": "string",
      "description": "PubMed Central identifier when available"
    },
    "doi": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "authors": {
      "type": "string"
    },
    "journal": {
      "type": "string"
    },
    "publication_date": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "abstract_language": {
      "type": "string",
      "description": "Detected language of the abstract"
    },
    "abstract_translation": {
      "type": "string",
      "description": "English translation when the abstract is not in English or French"
    },
    "full_text_url": {
      "type": "string"
    },
    "full_text_status": {
      "type": "string",
      "enum": [
        "Not needed",
        "Requested",
        "Received"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ]
    },
    "full_text_file_uri": {
      "type": "string",
      "description": "Private upload of the full text PDF"
    },
    "country": {
      "type": "string"
    },
    "matched_products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_of": {
      "type": "string",
      "description": "Earlier Article id this record duplicates"
    },
    "duplicate_reason": {
      "type": "string",
      "description": "Why the record matched: PMID, DOI, exact title, fuzzy title or existing case"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "AI Triaged",
        "In Review",
        "Decided",
        "Nullified"
      ],
      "enumColors": [
        "gray",
        "blue",
        "yellow",
        "green",
        "red"
      ]
    },
    "nullified": {
      "type": "boolean",
      "default": false
    },
    "nullified_reason": {
      "type": "string"
    }
  },
  "required": [
    "search_run",
    "title",
    "source_database"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}