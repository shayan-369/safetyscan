{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "Contact author",
        "Partner exchange",
        "Notify Health Canada",
        "Full text request",
        "Other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "red",
        "teal",
        "gray"
      ]
    },
    "article": {
      "type": "string"
    },
    "case": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Done"
      ],
      "enumColors": [
        "yellow",
        "green"
      ]
    }
  },
  "required": [
    "title",
    "kind",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}