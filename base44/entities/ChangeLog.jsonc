{
  "name": "ChangeLog",
  "type": "object",
  "properties": {
    "area": {
      "type": "string",
      "enum": [
        "Triage prompt",
        "Confidence threshold",
        "AI model",
        "Search frequency"
      ],
      "enumColors": [
        "blue",
        "purple",
        "teal",
        "gray"
      ]
    },
    "change": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_role": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending approval",
        "Approved"
      ],
      "enumColors": [
        "yellow",
        "green"
      ]
    }
  },
  "required": [
    "area",
    "change",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}