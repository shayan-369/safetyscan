{
  "name": "Triage",
  "type": "object",
  "properties": {
    "article": {
      "type": "string",
      "description": "Article id"
    },
    "category": {
      "type": "string",
      "enum": [
        "Potential Reportable Case",
        "Safety Information/Possible Signal",
        "Not Relevant"
      ],
      "enumColors": [
        "red",
        "yellow",
        "gray"
      ]
    },
    "not_relevant_reason": {
      "type": "string",
      "enum": [
        "Animal or lab study",
        "Different product or ingredient",
        "No adverse event",
        "Review article with no new cases",
        "Other"
      ],
      "enumColors": [
        "gray",
        "gray",
        "gray",
        "gray",
        "gray"
      ]
    },
    "human_subject": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unclear"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow"
      ]
    },
    "adverse_event_present": {
      "type": "boolean"
    },
    "identifiable_patient": {
      "type": "boolean"
    },
    "identifiable_reporter": {
      "type": "boolean"
    },
    "suspect_product_named": {
      "type": "boolean"
    },
    "suspect_per_author": {
      "type": "boolean",
      "description": "Author names our product as the suspect"
    },
    "brand_identified": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "enumColors": [
        "green",
        "yellow"
      ]
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reactions_coded": {
      "type": "array",
      "description": "Verbatim terms with AI-suggested MedDRA Preferred Terms",
      "items": {
        "type": "object",
        "properties": {
          "verbatim": {
            "type": "string"
          },
          "ai_pt": {
            "type": "string"
          }
        }
      }
    },
    "patients": {
      "type": "array",
      "description": "Each identifiable patient described in the article",
      "items": {
        "type": "object",
        "properties": {
          "descriptor": {
            "type": "string"
          },
          "age": {
            "type": "number"
          },
          "sex": {
            "type": "string"
          },
          "reactions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outcome": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "fatal_outcome": {
            "type": "boolean"
          }
        }
      }
    },
    "several_patients_unnamed": {
      "type": "boolean",
      "description": "Article mentions several patients without individual details"
    },
    "seriousness": {
      "type": "string",
      "enum": [
        "Serious",
        "Non-serious",
        "Unclear"
      ],
      "enumColors": [
        "red",
        "green",
        "yellow"
      ]
    },
    "seriousness_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expectedness": {
      "type": "string",
      "enum": [
        "Expected",
        "Unexpected",
        "Unclear"
      ],
      "enumColors": [
        "green",
        "yellow",
        "yellow"
      ]
    },
    "occurred_in": {
      "type": "string",
      "enum": [
        "Canada",
        "Foreign",
        "Unknown"
      ],
      "enumColors": [
        "blue",
        "gray",
        "yellow"
      ]
    },
    "special_situations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Pregnancy or breastfeeding, medication error, misuse or abuse, off-label use, overdose, lack of efficacy, drug interaction"
    },
    "relevant_for_asr": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "enumColors": [
        "blue",
        "gray"
      ]
    },
    "detected_language": {
      "type": "string"
    },
    "abstract_translation": {
      "type": "string",
      "description": "English translation kept alongside the original abstract"
    },
    "confidence": {
      "type": "number",
      "description": "0-100"
    },
    "evidence_quotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ai_summary": {
      "type": "string"
    },
    "ai_model": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "qc_sample": {
      "type": "boolean",
      "default": false
    },
    "nullified": {
      "type": "boolean",
      "default": false
    },
    "nullified_reason": {
      "type": "string"
    }
  },
  "required": [
    "article",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}