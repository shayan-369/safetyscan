{
  "name": "Product",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "description": "Brand name of the company product"
    },
    "active_ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Active ingredients"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_type": {
      "type": "string",
      "enum": [
        "Drug",
        "Natural Health Product"
      ],
      "enumColors": [
        "blue",
        "green"
      ]
    },
    "licence_number": {
      "type": "string",
      "description": "DIN or NPN"
    },
    "division": {
      "type": "string",
      "enum": [
        "Hospital",
        "Community"
      ],
      "enumColors": [
        "purple",
        "blue"
      ]
    },
    "indication": {
      "type": "string"
    },
    "labelled_reactions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "label_complete": {
      "type": "boolean",
      "default": false,
      "description": "Labelled reactions confirmed; until true every reaction is treated as unexpected"
    },
    "portfolio_status": {
      "type": "string",
      "enum": [
        "Confirmed",
        "To be confirmed by an Admin"
      ],
      "enumColors": [
        "green",
        "yellow"
      ]
    },
    "imported": {
      "type": "boolean",
      "default": false
    },
    "partner_company": {
      "type": "string"
    },
    "screens_literature": {
      "type": "string",
      "enum": [
        "Seaford",
        "Partner",
        "Both"
      ],
      "enumColors": [
        "blue",
        "purple",
        "teal"
      ]
    },
    "reports_to_hc": {
      "type": "string",
      "enum": [
        "Seaford",
        "Partner"
      ],
      "enumColors": [
        "blue",
        "purple"
      ]
    },
    "agreement_effective_date": {
      "type": "string",
      "format": "date"
    },
    "agreement_file_uri": {
      "type": "string"
    },
    "partner_days_to_exchange": {
      "type": "number"
    },
    "data_lock_point": {
      "type": "string",
      "format": "date",
      "description": "Annual Summary Report data lock point"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "brand_name",
    "product_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}