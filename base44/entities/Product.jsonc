{
  "name": "Product",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "description": "Brand name of the company product"
    },
    "active_ingredients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Active ingredients"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other names the product appears under in literature"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "Drug",
        "Natural Health Product"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "description": "Regulatory product type"
    },
    "licence_number": {
      "type": "string",
      "description": "DIN or NPN"
    },
    "division": {
      "type": "string",
      "enum": [
        "Hospital",
        "Community"
      ],
      "enumColors": [
        "purple",
        "blue"
      ],
      "description": "Business division"
    },
    "indication": {
      "type": "string",
      "description": "Approved indication"
    },
    "labelled_reactions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reactions already described in the Canadian label, used to judge expected vs unexpected"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Include in weekly searches"
    }
  },
  "required": [
    "brand_name",
    "product_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}